{
  "name": "todo-backend",
  "version": "1.0.0",
  "description": "Minimal GraphQL API (Apollo Server) with user-scoped to-dos",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:lambda": "esbuild src/lambda.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/aws-lambda": "^4.1.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
